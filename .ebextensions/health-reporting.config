# Elastic Beanstalk Enhanced Health configuration.
#
# This is a low-traffic demo environment. During quiet sampling windows the
# only requests reaching the origin are benign 404s (browser /favicon.ico,
# vulnerability scanners probing /wp-login.php, /.env, etc.). Enhanced Health
# then reports "100% of requests are erroring with 4xx" and flips the
# environment Severe -> Ok repeatedly, even though the app is healthy.
#
# Disabling the ApplicationRequests4xx rule stops 4xx responses from degrading
# environment health. 5xx responses (real server faults) still affect health.
# Reference:
# https://docs.aws.amazon.com/elasticbeanstalk/latest/dg/health-enhanced-status.html
option_settings:
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced
    ConfigDocument: '{"Version":1,"Rules":{"Environment":{"Application":{"ApplicationRequests4xx":{"Enabled":false}},"ELB":{"ELBRequests4xx":{"Enabled":false}}}}}'
